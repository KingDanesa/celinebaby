# Локальная разработка. Боевые настройки: deploy/env.production.example

# Админка
ADMIN_PASSWORD=change-me
ADMIN_SECRET=generate-a-long-random-string

# База данных. Выбор хранилища:
#   DATABASE_URL              → своя PostgreSQL (боевой сервер)
#   SUPABASE_URL + ключ       → Supabase (демо на Vercel)
#   ничего                    → локальные JSON-файлы, без личных кабинетов
DATABASE_URL=
MEDIA_DIR=media
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images

# Адрес сайта (ссылки в письмах и возврат из банка)
SITE_URL=http://localhost:3000

# Halyk ePay. HALYK_TEST=1 — тестовый терминал (деньги не списываются), 0 — боевой
HALYK_TEST=1
HALYK_CLIENT_ID=test
HALYK_CLIENT_SECRET=yF587AV9Ms94qN2QShFzVR3vFnWkhjbAK3sG
HALYK_TERMINAL=67e34d63-102f-4bd1-898e-370781d0074d
# Секрет таймера перепроверки оплат
CRON_SECRET=

# Письма: SMTP (любой ящик) или Resend. Без них письма только пишутся в лог
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM=Celine Baby <onboarding@resend.dev>
ORDER_NOTIFY_EMAIL=celinebabykazakhstan@gmail.com
