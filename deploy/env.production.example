# /etc/celinebaby/env — production settings (owner root, group celine, mode 640).
# setup-server.sh fills in the generated values; the rest you add by hand.

# Address of the site. Before the domain is switched you can use the temporary preview address.
SITE_URL=https://celinebaby.kz
NEXT_PUBLIC_SITE_URL=https://celinebaby.kz

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Own PostgreSQL on this server (generated)
DATABASE_URL=postgres://celinebaby:CHANGE_ME@127.0.0.1:5432/celinebaby
# Photos: old-site photos in image/, admin uploads in uploads/
MEDIA_DIR=/srv/celinebaby-media

# Admin panel (generated; give the password to the content manager)
ADMIN_PASSWORD=CHANGE_ME
ADMIN_SECRET=CHANGE_ME
# Secret for the payment re-check timer (generated)
CRON_SECRET=CHANGE_ME

# Halyk ePay. HALYK_TEST=1 — test terminal, no real money. Switch to 0 with the live keys on launch day.
HALYK_TEST=1
HALYK_CLIENT_ID=test
HALYK_CLIENT_SECRET=yF587AV9Ms94qN2QShFzVR3vFnWkhjbAK3sG
HALYK_TERMINAL=67e34d63-102f-4bd1-898e-370781d0074d

# E-mails about orders. Fill ONE of the two options.
# Option A — any mailbox over SMTP (e.g. Gmail with an "app password", or the domain's mail at the host):
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Option B — resend.com with the celinebaby.kz domain verified:
RESEND_API_KEY=
# Sender and who gets "new order" notifications (several addresses: comma-separated)
EMAIL_FROM=Celine Baby <orders@celinebaby.kz>
ORDER_NOTIFY_EMAIL=celinebabykazakhstan@gmail.com
